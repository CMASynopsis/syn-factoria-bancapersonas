# =============================================================================
# Banca Nacional - Deploy Profile Template
# =============================================================================
# Copiar a dev.env o prod.env y completar valores.
# Usado por: .github/workflows/deploy-app-javaee.yml (GitHub Environments)
#
# Para configurar en GitHub:
#   1. Ir a Settings > Environments > [dev|prod]
#   2. Agregar como Secrets: DEPLOY_HOST, DEPLOY_USER, DEPLOY_KEY
#   3. Agregar como Variables: DEPLOY_PORT, WILDFLY_DEPLOY_PATH
# =============================================================================

# ---------------------------------------------------------------------------
# Secrets (encriptados - configurar en GitHub Environment)
# ---------------------------------------------------------------------------
# DEPLOY_HOST=wildfly.ejemplo.com
# DEPLOY_USER=admin
# DEPLOY_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...

# ---------------------------------------------------------------------------
# Variables (texto plano, con defaults)
# ---------------------------------------------------------------------------
# DEPLOY_PORT=22
# WILDFLY_DEPLOY_PATH=/opt/wildfly/standalone/deployments

# ---------------------------------------------------------------------------
# Opcional: sobrescribe el ambiente destino
# ---------------------------------------------------------------------------
# DEPLOY_ENVIRONMENT=dev
