# Wildfly K8s Configuration for <profile>
# Copy this file and update values as needed
#
# Usage:
#   cp profile.env.example dev.env
#   # Edit dev.env with your values
#   ./scripts/k8s/wildfly/configure.sh apply -p dev
#
# Or export individual vars and run:
#   export K8S_NAMESPACE=wildfly
#   ./scripts/k8s/wildfly/configure.sh apply

# ═══════════════════════════════════════════════════════════════════════════
# Kubernetes Cluster Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Namespace donde se desplegará Wildfly
# K8S_NAMESPACE=wildfly

# Contexto de kubectl (opcional — si se omite se usa el contexto actual)
# K8S_CONTEXT=microk8s

# ═══════════════════════════════════════════════════════════════════════════
# Wildfly Image
# ═══════════════════════════════════════════════════════════════════════════

# Imagen Docker de Wildfly con SSH
# WILDFLY_IMAGE=wildfly-ssh:26.1.2.Final

# Número de réplicas del deployment
# WILDFLY_REPLICAS=1

# ═══════════════════════════════════════════════════════════════════════════
# Ports
# ═══════════════════════════════════════════════════════════════════════════

# HTTP port (Wildfly)
# WILDFLY_HTTP_PORT=8080

# Management/Admin port (Wildfly Admin Console)
# WILDFLY_ADMIN_PORT=9990

# Puerto local para port-forward SSH (se mapea al puerto 22 del pod)
# LOCAL_SSH_PORT=2222

# ═══════════════════════════════════════════════════════════════════════════
# SSH User Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Usuario para despliegues SSH
# WILDFLY_DEPLOY_USER=deploy

# Password para el usuario deploy
# WILDFLY_DEPLOY_PASSWORD=deploy

# Clave pública SSH para autenticación
# Inyectada al iniciar el contenedor via WILDFLY_SSH_PUBLIC_KEY
# WILDFLY_SSH_PUBLIC_KEY=ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ...

# ═══════════════════════════════════════════════════════════════════════════
# JVM / Wildfly Options
# ═══════════════════════════════════════════════════════════════════════════

# Memoria XMS
# WILDFLY_XMS=512m

# Memoria XMX
# WILDFLY_XMX=1024m

# Argumentos adicionales para standalone.sh
# WILDFLY_JAVA_OPTS=-Djboss.node.name=wildfly-node

# ═══════════════════════════════════════════════════════════════════════════
# Health Checks
# ═══════════════════════════════════════════════════════════════════════════

# Health check timeout in seconds
# HEALTH_CHECK_TIMEOUT=120

# Health check interval in seconds
# HEALTH_CHECK_INTERVAL=5

# ═══════════════════════════════════════════════════════════════════════════
# Storage
# ═══════════════════════════════════════════════════════════════════════════

# Tamaño del volumen persistente para deployments
# STORAGE_SIZE=1Gi

# ═══════════════════════════════════════════════════════════════════════════
# Service
# ═══════════════════════════════════════════════════════════════════════════

# Tipo de servicio Kubernetes (ClusterIP, NodePort, LoadBalancer)
# SERVICE_TYPE=ClusterIP

# ═══════════════════════════════════════════════════════════════════════════
# Usage Instructions
# ═══════════════════════════════════════════════════════════════════════════

# 1. Create dev.env from this template:
#    cp scripts/k8s/wildfly/profile.env.example scripts/k8s/wildfly/dev.env
#
# 2. Apply manifests to the cluster:
#    ./scripts/k8s/wildfly/configure.sh apply
#
# 3. Check pod status:
#    ./scripts/k8s/wildfly/run.sh status
#
# 4. View logs:
#    ./scripts/k8s/wildfly/run.sh logs
#
# 5. SSH into the pod:
#    ./scripts/k8s/wildfly/run.sh ssh
#
# 6. Restart the deployment:
#    ./scripts/k8s/wildfly/run.sh restart
#
# 7. Scale replicas:
#    ./scripts/k8s/wildfly/run.sh scale 3
#
# 8. Destroy all resources:
#    ./scripts/k8s/wildfly/configure.sh destroy
