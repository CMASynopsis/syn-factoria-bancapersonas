# Wildfly Configuration for <profile>
# Copy this file and update values as needed
#
# Usage:
#   cp profile.env.example dev.env
#   # Edit dev.env with your values
#   ./scripts/docker/wildfly/wildfly.sh start -p dev
#
# Or export individual vars and run:
#   export WILDFLY_SSH_PORT=2222
#   ./scripts/docker/wildfly/wildfly.sh start

# ═══════════════════════════════════════════════════════════════════════════
# Wildfly Server Profile
# ═══════════════════════════════════════════════════════════════════════════

# Docker image for Wildfly
# WILDFLY_IMAGE=wildfly-ssh:26.1.2.Final

# Container name
# WILDFLY_CONTAINER_NAME=geniahr-wildfly

# Docker network
# NETWORK_NAME=geniahr-network

# ═══════════════════════════════════════════════════════════════════════════
# Ports
# ═══════════════════════════════════════════════════════════════════════════

# SSH port (mapeado al puerto 22 del contenedor)
# Este es el puerto que usa el pipeline CI/CD para SCP y SSH
# WILDFLY_SSH_PORT=2222

# HTTP port (Wildfly)
# WILDFLY_HTTP_PORT=8080

# Management/Admin port (Wildfly Admin Console)
# WILDFLY_ADMIN_PORT=9990

# ═══════════════════════════════════════════════════════════════════════════
# SSH User Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Usuario para despliegues SSH
# WILDFLY_DEPLOY_USER=deploy

# Password para el usuario deploy
# WILDFLY_DEPLOY_PASSWORD=deploy

# Clave publica SSH para autenticacion
# Inyectada al iniciar el contenedor via WILDFLY_SSH_PUBLIC_KEY
# WILDFLY_SSH_PUBLIC_KEY=ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ...

# ═══════════════════════════════════════════════════════════════════════════
# Wildfly Paths (inside container)
# ═══════════════════════════════════════════════════════════════════════════

# Ruta de deployments (donde el pipeline copia el .ear)
# WILDFLY_DEPLOY_PATH=/opt/jboss/wildfly/standalone/deployments

# Wildfly home
# WILDFLY_HOME=/opt/jboss/wildfly

# ═══════════════════════════════════════════════════════════════════════════
# JVM / Wildfly Options
# ═══════════════════════════════════════════════════════════════════════════

# Memoria XMS
# WILDFLY_XMS=512m

# Memoria XMX
# WILDFLY_XMX=1024m

# Argumentos adicionales para standalone.sh
# WILDFLY_JAVA_OPTS=-Djboss.node.name=wildfly-node

# ═══════════════════════════════════════════════════════════════════════════
# Health Checks
# ═══════════════════════════════════════════════════════════════════════════

# Health check timeout in seconds
# HEALTH_CHECK_TIMEOUT=120

# Health check interval in seconds
# HEALTH_CHECK_INTERVAL=5

# Wildfly HTTP endpoint for health check
# HEALTH_CHECK_URL=http://localhost:8080/

# ═══════════════════════════════════════════════════════════════════════════
# Volume Mounts
# ═══════════════════════════════════════════════════════════════════════════

# Montar directorio de deployments desde el host (opcional)
# Permite desplegar ears sin necesidad de SCP (para desarrollo local)
# WILDFLY_DEPLOYMENTS_HOST_DIR=./wildfly-deployments

# Montar configuración standalone desde el host (opcional)
# WILDFLY_CONFIG_HOST_DIR=./wildfly-config

# ═══════════════════════════════════════════════════════════════════════════
# Usage Instructions
# ═══════════════════════════════════════════════════════════════════════════

# 1. Build the image:
#    ./scripts/docker/wildfly/wildfly.sh build
#
# 2. Create dev.env from this template:
#    cp scripts/docker/wildfly/profile.env.example scripts/docker/wildfly/dev.env
#
# 3. Start Wildfly:
#    ./scripts/docker/wildfly/wildfly.sh start
#
# 4. Check status:
#    ./scripts/docker/wildfly/wildfly.sh status
#
# 5. Deploy EAR via SCP (example):
#    scp -P 2222 apps/backend-for-frontend/app-javaee/banca-ear/target/banca-nacional.ear \
#      deploy@localhost:/opt/jboss/wildfly/standalone/deployments/
#
# 6. SSH into container:
#    ./scripts/docker/wildfly/wildfly.sh ssh
#
# 7. View logs:
#    ./scripts/docker/wildfly/wildfly.sh logs
#
# 8. Stop Wildfly:
#    ./scripts/docker/wildfly/wildfly.sh stop
