# Kafka Configuration for Development
# Copy this file and update values as needed

# ═══════════════════════════════════════════════════════════════════════════
# Kafka Infrastructure Profile (docker-compose.yml + kafka.sh)
# ═══════════════════════════════════════════════════════════════════════════

# Kafka mode: kraft (default, no Zookeeper) or zookeeper (legacy)
# KAFKA_MODE=kraft

# Images
# KAFKA_IMAGE=confluentinc/cp-kafka:7.8.1
# ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.8.1

# Ports
# KAFKA_PORT=9092
# KAFKA_INTERNAL_PORT=29092
# ZOOKEEPER_PORT=2181

# Container names
# KAFKA_CONTAINER_NAME=geniahr-kafka
# ZOOKEEPER_CONTAINER_NAME=geniahr-zookeeper
# KAFKA_INIT_CONTAINER_NAME=geniahr-kafka-init

# Network
# NETWORK_NAME=geniahr-network

# Topic defaults
# TOPIC_PARTITIONS=1
# TOPIC_REPLICATION_FACTOR=1
# TOPIC_RETENTION_MS=604800000      # 7 days
# TOPIC_SEGMENT_MS=86400000         # 1 day
# TOPIC_COMPRESSION=snappy

# Log retention
# KAFKA_LOG_RETENTION_HOURS=168     # 7 days
# KAFKA_LOG_RETENTION_BYTES=1073741824
# KAFKA_LOG_SEGMENT_BYTES=1073741824

# Health checks
# HEALTH_CHECK_TIMEOUT=120
# HEALTH_CHECK_INTERVAL=5

# ═══════════════════════════════════════════════════════════════════════════
# Kafka Bootstrap Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Kafka broker address
# For local development: localhost:9092
# For Docker Compose: geniahr-kafka:29092 (internal)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092



# ═══════════════════════════════════════════════════════════════════════════
# Usage Instructions
# ═══════════════════════════════════════════════════════════════════════════

# 1. For local development (localhost):
#    export $(cat dev.env | grep -v '#' | xargs)
#
# 2. For Docker Compose (update KAFKA_BOOTSTRAP_SERVERS):
#    KAFKA_BOOTSTRAP_SERVERS=geniahr-kafka:29092
#
# 3. Run requirements-api-ms:
#    cd apps/backend/requirements-api-ms
#    ./mvnw quarkus:dev -Drun.jvmArguments="-Dkafka.bootstrap.servers=${KAFKA_BOOTSTRAP_SERVERS}"
#
# 4. Run geniahr-recruitment-api:
#    cd apps/backend/geniahr-recruitment-api
#    ./mvnw quarkus:dev -Drun.jvmArguments="-Dkafka.bootstrap.servers=${KAFKA_BOOTSTRAP_SERVERS}"
#
# 5. Test flow:
#    a) Start Kafka: ./scripts/docker/messaging/kafka.sh start
#    b) Create a requirement: POST /requirementapi/v1/requirements
#    c) Activate it: PATCH /requirementapi/v1/requirements/{id}/status
#    d) Check recruitment created: GET /recruitmentapi/...
