# Kafka Configuration for Development
# Copy this file and update values as needed

# ═══════════════════════════════════════════════════════════════════════════
# Kafka Bootstrap Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Kafka broker address
# For local development: localhost:9092
# For Docker Compose: geniahr-kafka:29092 (internal)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ═══════════════════════════════════════════════════════════════════════════
# Producer Configuration (requirements-api-ms)
# ═══════════════════════════════════════════════════════════════════════════

# Producer acknowledgment level
# all     = wait for all replicas (most reliable)
# leader  = wait for leader (balanced)
# none    = no confirmation (fastest)
KAFKA_PRODUCER_ACKS=all

# Number of retries for failed sends
KAFKA_PRODUCER_RETRIES=3

# Size of batch (bytes)
KAFKA_PRODUCER_BATCH_SIZE=16384

# Max time to wait for batch (milliseconds)
KAFKA_PRODUCER_LINGER_MS=10

# Compression type: snappy, lz4, gzip, none
KAFKA_PRODUCER_COMPRESSION_TYPE=snappy

# ═══════════════════════════════════════════════════════════════════════════
# Consumer Configuration (geniahr-recruitment-api)
# ═══════════════════════════════════════════════════════════════════════════

# Consumer group ID - identifies the consumer group
KAFKA_CONSUMER_GROUP_ID=recruitment-api-consumer

# Where to start reading if no offset exists
# earliest = from beginning
# latest   = from end
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# Max records to poll per request (for sequential processing, keep at 1)
KAFKA_CONSUMER_MAX_POLL_RECORDS=1

# Session timeout (milliseconds)
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=30000

# ═══════════════════════════════════════════════════════════════════════════
# Topic Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Topic for active requirements
KAFKA_TOPIC_ACTIVE_REQUIREMENTS=requirements.active

# ═══════════════════════════════════════════════════════════════════════════
# Microservices Ports
# ═══════════════════════════════════════════════════════════════════════════

# requirements-api-ms
SERVER_PORT=8081
HTTP_HOST=0.0.0.0

# geniahr-recruitment-api
RECRUITMENT_SERVER_PORT=9080

# ═══════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════

# requirements-api-ms database
DB_USER=factoria
DB_PASSWORD=factoria
DB_HOST=localhost
DB_PORT=5432
DB_NAME=requirements_db
DB_MAX_CONNECTION=5

# geniahr-recruitment-api database
RECRUITMENT_DB_USER=factoria
RECRUITMENT_DB_PASSWORD=factoria
RECRUITMENT_DB_HOST=localhost
RECRUITMENT_DB_PORT=5432
RECRUITMENT_DB_NAME=recruitment_db

# ═══════════════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════════════

LOG_LVL_ROOT=DEBUG
LOG_LVL_KAFKA=INFO
LOG_LVL_CAMEL=INFO

# ═══════════════════════════════════════════════════════════════════════════
# Usage Instructions
# ═══════════════════════════════════════════════════════════════════════════

# 1. For local development (localhost):
#    export $(cat kafka.env.example | grep -v '#' | xargs)
#
# 2. For Docker Compose (update KAFKA_BOOTSTRAP_SERVERS):
#    KAFKA_BOOTSTRAP_SERVERS=geniahr-kafka:29092
#
# 3. Run requirements-api-ms:
#    cd apps/backend/requirements-api-ms
#    ./mvnw quarkus:dev -Drun.jvmArguments="-Dkafka.bootstrap.servers=${KAFKA_BOOTSTRAP_SERVERS}"
#
# 4. Run geniahr-recruitment-api:
#    cd apps/backend/geniahr-recruitment-api
#    ./mvnw quarkus:dev -Drun.jvmArguments="-Dkafka.bootstrap.servers=${KAFKA_BOOTSTRAP_SERVERS}"
#
# 5. Test flow:
#    a) Start Kafka: cd infra/docker/messaging && ./manage-kafka.sh start
#    b) Create a requirement: POST /requirementapi/v1/requirements
#    c) Activate it: PATCH /requirementapi/v1/requirements/{id}/status
#    d) Check recruitment created: GET /recruitmentapi/...
